# Development bot settings.
# Copy this file to .env.development and use a separate Discord application/bot.
# Do not paste the production bot token here.

DISCORD_TOKEN=your_development_bot_token_here
DISCORD_CLIENT_ID=your_development_application_client_id_here

# Required for npm.cmd run deploy:dev. Development commands are registered only in this guild.
DISCORD_GUILD_ID=your_test_server_id_here

# Access users are Discord user IDs, not usernames.
ADMIN_USER_IDS=your_discord_user_id_here
DEV_USER_IDS=your_discord_user_id_here
ERROR_DM_USER_IDS=your_discord_user_id_here

# Development bot presence.
BOT_ACTIVITY=Production Development testing
BOT_ACTIVITY_TYPE=watching
BOT_STATUS=dnd

# Optional integrations for testing. Use separate test keys where possible.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TOGETHER_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo-Free
TOGETHER_API_KEY=
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=openai/gpt-oss-120b:fastest
