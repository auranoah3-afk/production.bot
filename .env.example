# Required Discord app settings.
DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_application_client_id_here

# Optional, but recommended while testing. Used by deploy to clear old guild-specific slash commands.
DISCORD_GUILD_ID=optional_test_server_id

# Access users are Discord user IDs, not usernames.
ADMIN_USER_IDS=comma_separated_discord_user_ids_allowed_to_use_bot_admin_commands
DEV_USER_IDS=comma_separated_discord_user_ids_allowed_to_use_dev_commands
ERROR_DM_USER_IDS=comma_separated_discord_user_ids_for_error_dm_alerts

# Optional backup email alerts for bot errors.
ERROR_EMAIL_TO=owner@example.com,backup@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=smtp_username_or_email
SMTP_PASS=smtp_password_or_app_password
SMTP_FROM=V2 Community Bot <bot@example.com>

# Bot presence.
BOT_ACTIVITY=Beta Testing New Commands !
BOT_ACTIVITY_TYPE=watching
BOT_ACTIVITY_URL=https://www.twitch.tv/discord
BOT_STATUS=online

# Optional Twitch live alerts.
TWITCH_CLIENT_ID=your_twitch_client_id_here
TWITCH_CLIENT_SECRET=your_twitch_client_secret_here

# Optional AI providers for joined chat.
TOGETHER_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo-Free
TOGETHER_API_KEY=your_together_ai_api_key_here
HUGGINGFACE_API_KEY=your_huggingface_api_key_here
HUGGINGFACE_MODEL=openai/gpt-oss-120b:fastest

# GROQ_API_KEY is only supported as a legacy fallback and may not work for Together.ai.
GROQ_API_KEY=optional_legacy_groq_api_key_for_fallback
